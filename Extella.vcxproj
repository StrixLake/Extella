<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  	<ItemGroup>
    	<ProjectConfiguration Include="Debug|x64">
      	<Configuration>Debug</Configuration>
      	<Platform>x64</Platform>
    	</ProjectConfiguration>
    	<ProjectConfiguration Include="Release|x64">
      	<Configuration>Release</Configuration>
      	<Platform>x64</Platform>
    	</ProjectConfiguration>
  	</ItemGroup>
	  
	  
	<PropertyGroup>
		<!-- Default config-->
		<Configuration>Release</Configuration>
    	<ConfigurationType>DynamicLibrary</ConfigurationType>
    	<!-- MSVC toolset-->
    	<PlatformToolset>v143</PlatformToolset>
    	<Platform>x64</Platform>
    	<TargetName>Extella</TargetName>
    	<OutDir>.\x64\$(Configuration)\bin\Extella\</OutDir>
    	<IntDir>.\x64\$(Configuration)\obj\Extella\</IntDir>
    	<BuildInParallel>true</BuildInParallel>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Debug'">
		<UseDebugLibraries>true</UseDebugLibraries>
	</PropertyGroup>
	<PropertyGroup Condition="$(Configuration) == 'Release'">
		<UseDebugLibraries>false</UseDebugLibraries>
	</PropertyGroup>
	<PropertyGroup Label="Globals">
		<ProjectGuid>{78330846-DA7F-26E8-AFEF-61C7FA51BFE8}</ProjectGuid>
	</PropertyGroup>
	
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  	<ItemDefinitionGroup>
    	<ClCompile>
      		<EnableEnhancedInstructionSet>AdvancedVectorExtensions512</EnableEnhancedInstructionSet>
      		<AdditionalIncludeDirectories>
				$(ProjectDir);C:\Users\yasha\Documents\Repositories\tinyobjloader;C:\Users\yasha\Documents\Repositories\stb;C:\Users\yasha\Documents\Repositories\Boost\include\boost-1_90
			</AdditionalIncludeDirectories>
      		<LanguageStandard>stdcpp17</LanguageStandard>
      		<WarningLevel>Level4</WarningLevel>
      		<DisableSpecificWarnings>4267;4244;4305;4100</DisableSpecificWarnings>
    	</ClCompile>

    	<Link>
			 <AdditionalLibraryDirectories>C:\Users\yasha\Documents\Repositories\Boost\lib</AdditionalLibraryDirectories>
      		<AdditionalDependencies>
                	d3d9.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;kernel32.lib;user32.lib;oleaut32.lib;ole32.lib
        	</AdditionalDependencies>

      		<GenerateDebugInformation>true</GenerateDebugInformation>
      		<ProgramDatabaseFile>$(OutDir)Extella.pdb</ProgramDatabaseFile>
      		<SubSystem>Windows</SubSystem>
    	</Link>
		
    	<FxCompile>
      		<ShaderModel>5.0</ShaderModel>
			<ObjectFileOutput>$(OutDir)shaders/%(Filename).cso</ObjectFileOutput>
    	</FxCompile>
  	</ItemDefinitionGroup>
  	<ItemDefinitionGroup Condition="$(Configuration) == 'Debug'">
    	<ClCompile>
      	<Optimization>Disabled</Optimization>
    	</ClCompile>
  	</ItemDefinitionGroup>
  	<ItemDefinitionGroup Condition="$(Configuration) == 'Release'">
    	<ClCompile>
      	<Optimization>MaxSpeed</Optimization>
    	</ClCompile>
  	</ItemDefinitionGroup>
  	<ItemGroup>
		<ClInclude Include="*.h"/>

    	<ClCompile Include="extella.cpp" />
    	<ClCompile Include="device.cpp" />
    	<ClCompile Include="mesh.cpp" />
    	<ClCompile Include="objLoader.cpp" />
    	<ClCompile Include="render.cpp" />
    	<ClCompile Include="shader.cpp" />
    	<ClCompile Include="watch.cpp" />
		<ClCompile Include="resources.cpp"/>
		<ClCompile Include="delegate.cpp"/>
		<ClCompile Include="query.cpp"/>
		<ClCompile Include="extension/vShader.cpp"/>
		<ClCompile Include="extension/tShader.cpp"/>
		<ClCompile Include="extension/gShader.cpp"/>
		<ClCompile Include="extension/pShader.cpp"/>
		<ClCompile Include="extension/uShader.cpp"/>
		<ClCompile Include="extension/configuration.cpp"/>

    	<Shaders Include="shaders\*" />
	
    	<Mesh Include="mesh\*" />

  	</ItemGroup>
  	
	<Target Name="Copy Mesh" AfterTargets="Build">
    	<Copy SkipUnchangedFiles="true" SourceFiles="@(Mesh)" DestinationFolder="$(OutDir)mesh" />
  	</Target>

  	<Target Name="Copy Shaders" AfterTargets="Build">
    	<Copy SkipUnchangedFiles="true" SourceFiles="@(Shaders)" DestinationFolder="$(OutDir)shaders" />
  	</Target>
</Project>